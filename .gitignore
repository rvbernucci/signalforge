# Local secrets and environment files
.env
.env.*
!.env.example

# Raw runs and private evaluation material never enter the public candidate. Only the small,
# privacy-safe aggregate files explicitly committed under evidence/ are public.
evidence/runs/
evidence/local/
evidence/private/
evidence/raw/
models/
var/
raw/
vectors/
extracted/
*.duckdb
*.parquet

# Go build output
bin/
vendor/
.artifacts/
.tmp-bin/
.tmp-sprint11/
tmp/
coverage.out

# Local executable produced by development verification
/signalforge-workspace

# Python caches and local environments
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/

# Frontend dependencies and generated output
web/node_modules/
web/dist/
web/*.tsbuildinfo
web/vite.config.js
web/vite.config.d.ts

# Runtime-only container secrets and state
.secrets/
.signalforge/

# Generated release media and local QA renders
output/

