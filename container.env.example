# SignalForge Radeon appliance configuration.
# Copying this file is not required: operator commands layer it beneath a generated, non-secret
# preflight environment. Never place credentials in this file.

# Runtime profile: fixture, radeon-local, or championship. Non-secret; operator-selected.
SIGNALFORGE_PROFILE=radeon-local

# Execution backend: auto, compose, or native. Auto prefers a healthy Docker Compose runtime and
# otherwise uses the pinned native Radeon path without installing host packages.
SIGNALFORGE_EXECUTION_BACKEND=auto

# Immutable linux/amd64 application and ROCm runtime identities. Non-secret; version-pinned.
SIGNALFORGE_APP_IMAGE=ghcr.io/rvbernucci/signalforge@sha256:cbac58cf3e62df0404e9ef1cfc7db6aec49e491e4beb5e1f214d6d562fad814b
SIGNALFORGE_LLAMA_ROCM_IMAGE=rocm/llama.cpp@sha256:be175932c3c96e882dfbc7e20e0e834f58c89c2925f48b222837ee929dfc47ee
SIGNALFORGE_PYTHON_IMAGE=python:3.12.11-alpine3.22@sha256:efcdfa6a6b2fd2afb9c7dfa9a5b288a6f68338b5cfdebe6b637d986067d85757
SIGNALFORGE_STORAGE_INIT_IMAGE=alpine:3.23@sha256:fd791d74b68913cbb027c6546007b3f0d3bc45125f797758156952bc2d6daf40

# Model contract. License acceptance is explicit and is recorded only by radeon-bootstrap.
SIGNALFORGE_MODEL_ID=signalforge-gemma4-26b-q4
SIGNALFORGE_MODEL_SOURCE=huggingface
SIGNALFORGE_ACCEPT_GEMMA_LICENSE=no
SIGNALFORGE_MODEL_DOWNLOAD_RETRIES=5
SIGNALFORGE_MODEL_DOWNLOAD_TIMEOUT_SECONDS=60

# Native backend startup/build bounds. All downloaded toolchains, caches, binaries, state, and
# logs remain under SIGNALFORGE_PERSIST_ROOT.
SIGNALFORGE_NATIVE_BUILD_TIMEOUT_SECONDS=1800
SIGNALFORGE_NATIVE_STARTUP_TIMEOUT_SECONDS=2400
SIGNALFORGE_NATIVE_APP_READY_TIMEOUT_SECONDS=120
SIGNALFORGE_NATIVE_MODEL_READY_TIMEOUT_SECONDS=900

# The following are derived by preflight and intentionally have no static assignment:
# SIGNALFORGE_PERSIST_ROOT
# SIGNALFORGE_VIDEO_GID
# SIGNALFORGE_RENDER_GID

# Local runtime tuning. Non-secret; selected from measured Radeon development evidence.
HSA_OVERRIDE_GFX_VERSION=11.0.0
SIGNALFORGE_CONTEXT_SIZE=32768
SIGNALFORGE_PARALLEL_SLOTS=4
SIGNALFORGE_BATCH_SIZE=2048
SIGNALFORGE_UBATCH_SIZE=512
SIGNALFORGE_FLASH_ATTN=auto
SIGNALFORGE_CACHE_TYPE_K=f16
SIGNALFORGE_CACHE_TYPE_V=f16

# Optional organizer Radeon API specialist route. The API key is a runtime file under .secrets,
# never an environment value.
SIGNALFORGE_SPECIALIST_API_ENABLED=false
SIGNALFORGE_SPECIALIST_API_PROVIDER=radeon-vllm
SIGNALFORGE_SPECIALIST_API_BASE_URL=https://radeon.anruicloud.com/api/v1
SIGNALFORGE_SPECIALIST_TEXT_MODEL=DeepSeek-V4-Flash
SIGNALFORGE_SPECIALIST_VISION_MODEL=Qwen3.6-35B-A3B
SIGNALFORGE_SPECIALIST_API_TIMEOUT=90s

# Optional observability. Telemetry services are not required for the research workspace.
SIGNALFORGE_OTEL_ENABLED=false
SIGNALFORGE_OTEL_INSECURE=true
SIGNALFORGE_OTEL_ALLOW_PRIVATE_NETWORK=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://alloy:4318

# Loopback-only host publications. Non-secret; operator-overridable.
SIGNALFORGE_APP_PORT=8080
SIGNALFORGE_GRAFANA_PORT=3000
SIGNALFORGE_PROMETHEUS_PORT=9090
SIGNALFORGE_ALLOY_PORT=12345
