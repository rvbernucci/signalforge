{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://signalforge.dev/contracts/accounting-professional-decision.schema.json",
  "title": "SignalForge Accounting Professional Decision",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "universe_id", "registry_version", "registry_sha256", "reviewer_name", "reviewer_qualification", "disposition", "approved_mapping_keys", "conditions", "rejected_scope", "decided_at", "record_locator", "decision_sha256"],
  "properties": {
    "schema_version": {"const": "signalforge/accounting-professional-decision/v1"},
    "universe_id": {"type": "string", "minLength": 1},
    "registry_version": {"type": "string", "minLength": 1},
    "registry_sha256": {"$ref": "#/$defs/sha256"},
    "reviewer_name": {"type": "string", "minLength": 1},
    "reviewer_qualification": {"type": "string", "minLength": 1},
    "disposition": {"const": "conditionally_accepted"},
    "approved_mapping_keys": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "conditions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "rejected_scope": {"type": "string", "minLength": 1},
    "decided_at": {"type": "string", "format": "date-time"},
    "record_locator": {"type": "string", "minLength": 1},
    "decision_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
