{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://signalforge.dev/contracts/technology20-peer-evaluation.schema.json",
  "title": "SignalForge Technology 20 Peer Evaluation",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "universe_id", "as_of", "policy_version", "lanes", "claim_boundary"],
  "properties": {
    "schema_version": {"const": "signalforge/technology20-peer-evaluation/v1"},
    "universe_id": {"type": "string", "minLength": 1},
    "as_of": {"type": "string", "format": "date-time"},
    "policy_version": {"type": "string", "minLength": 1},
    "promotion_decision_sha256": {"$ref": "#/$defs/sha256"},
    "lanes": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {"$ref": "#/$defs/evaluation"}
    },
    "claim_boundary": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lane_id", "company_ids", "receipts", "abstentions", "releasable_metric_ids", "withheld_metric_ids", "promoted", "reason_codes"],
      "properties": {
        "lane_id": {"type": "string", "minLength": 1},
        "company_ids": {"type": "array", "minItems": 2, "maxItems": 2, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "receipts": {"type": "array", "items": {"$ref": "metric-comparability-receipt.schema.json"}},
        "abstentions": {"type": "array", "items": {"$ref": "typed-abstention.schema.json"}},
        "releasable_metric_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "context_only_metric_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "withheld_metric_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "promoted": {"type": "boolean"},
        "reason_codes": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "envelope_sha256": {"$ref": "#/$defs/sha256"},
        "promotion_evidence_sha256": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/sha256"}}
      },
      "allOf": [
        {
          "if": {"properties": {"promoted": {"const": true}}},
          "then": {
            "required": ["promotion_evidence_sha256"],
            "properties": {"reason_codes": {"maxItems": 0}}
          },
          "else": {
            "properties": {
              "reason_codes": {"minItems": 1},
              "promotion_evidence_sha256": {"maxItems": 0}
            }
          }
        }
      ]
    }
  }
}
