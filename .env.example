# SEC requests require a descriptive application identity and contact address.
# This value is not a secret, but it is environment-specific and is never embedded in the binary.
SIGNALFORGE_SEC_USER_AGENT="SignalForge research contact@example.com"

# Optional external model-market evidence. Keep this server-side and never commit a real key.
ARTIFICIAL_ANALYSIS_API_KEY=""

# Optional BYOK sources. These are never required by the offline test suite.
FRED_API_KEY=""
ALPACA_API_KEY_ID=""
ALPACA_API_SECRET_KEY=""

# Optional Radeon Cloud vLLM specialist wave. Keep disabled for the all-local base path.
# Production should prefer API_KEY_FILE populated by OpenBao or the deployment secret manager.
SIGNALFORGE_SPECIALIST_API_ENABLED="false"
SIGNALFORGE_SPECIALIST_API_PROVIDER="radeon-vllm"
SIGNALFORGE_SPECIALIST_API_BASE_URL="https://radeon.anruicloud.com/api/v1"
SIGNALFORGE_SPECIALIST_API_KEY_FILE=""
SIGNALFORGE_SPECIALIST_TEXT_MODEL="DeepSeek-V4-Flash"
SIGNALFORGE_SPECIALIST_VISION_MODEL="Qwen3.6-35B-A3B"
SIGNALFORGE_SPECIALIST_API_TIMEOUT="90s"

# Compatibility fallback for evaluators that inject secrets only as environment variables.
# Never set this together with SIGNALFORGE_SPECIALIST_API_KEY_FILE.
SIGNALFORGE_SPECIALIST_API_KEY=""
